{
  "version": 2,
  "functions": {
    "api/*.js": {
      "maxDuration": 10
    }
  },
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/chart",
      "destination": "/api/chart.js"
    },
    {
      "source": "/api/chips",
      "destination": "/api/chips.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
